{
  "name": "@profullstack/coinpay-extension",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "CoinPay cross-browser (MV3) wallet + x402 payment extension with bulk payouts. See docs/BROWSER_EXTENSION_PRD.md and docs/BULK_PAYMENTS.md.",
  "scripts": {
    "build": "vite build",
    "build:firefox": "TARGET=firefox vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@profullstack/coinpay": "workspace:*",
    "@scure/bip39": "^1.4.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "buffer": "^6.0.3",
    "@scure/bip32": "^1.5.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "jsdom": "^23.2.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  }
}
