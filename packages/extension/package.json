{
  "name": "@profullstack/coinpay-extension",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "CoinPay cross-browser (MV3) wallet + x402 payment extension with bulk payouts. See docs/BROWSER_EXTENSION_PRD.md and docs/BULK_PAYMENTS.md.",
  "scripts": {
    "build": "vite build",
    "build:firefox": "TARGET=firefox vite build",
    "build:safari": "TARGET=safari vite build",
    "dev": "vite build --watch",
    "package": "node scripts/package.mjs",
    "screenshots": "node scripts/make-screenshots.mjs",
    "publish:chrome": "node scripts/publish-chrome.mjs",
    "publish:firefox": "node scripts/publish-firefox.mjs",
    "publish:safari": "./scripts/safari-convert.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@profullstack/coinpay": "workspace:*",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
