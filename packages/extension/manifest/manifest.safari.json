{
  "manifest_version": 3,
  "name": "CoinPay Portal Wallet",
  "description": "Non-custodial multi-chain CoinPay wallet with one-click x402 payments and bulk payouts.",
  "version": "0.10.1",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "action": {
    "default_title": "CoinPay",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://coinpayportal.com/*",
    "https://ugig.net/*",
    "https://www.ugig.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://coinpayportal.com/*",
        "https://ugig.net/*",
        "https://www.ugig.net/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inpage/provider.js"
      ],
      "matches": [
        "https://coinpayportal.com/*",
        "https://ugig.net/*",
        "https://www.ugig.net/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
